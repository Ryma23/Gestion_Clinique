<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.gestion_clinique.Controller.PatientController">
    <VBox spacing="10" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20"
          AnchorPane.topAnchor="20" AnchorPane.bottomAnchor="20">

        <HBox spacing="10" alignment="CENTER_RIGHT">
            <TextField fx:id="searchField" promptText="Rechercher un patient..."
                       prefWidth="300"/>
            <Button text="Rechercher" onAction="#handleSearch"
                    style="-fx-background-color: #006D77; -fx-text-fill: white;"/>
        </HBox>

        <TableView fx:id="patientTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="nomCol" text="Nom"/>
                <TableColumn fx:id="prenomCol" text="Prénom"/>
                <TableColumn fx:id="ageCol" text="Age"/>
                <TableColumn fx:id="emailCol" text="Email"/>
                <TableColumn fx:id="phoneCol" text="Téléphone"/>
                <TableColumn fx:id="regionCol" text="Region"/>
                <TableColumn fx:id="actionsCol" text="Actions" prefWidth="100"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>

    </VBox>
</AnchorPane>
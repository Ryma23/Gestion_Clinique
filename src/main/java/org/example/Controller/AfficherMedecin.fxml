<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.GUI.AfficherMedecinController"
            style="-fx-background-color: #FFFFFF;">

    <HBox AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0">
        <!-- Left Sidebar -->
        <VBox style="-fx-background-color: #05696B; -fx-padding: 20;" prefWidth="200">
            <Label text="Gestion Clinique"
                   style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>

            <!-- Menu Items -->
            <VBox spacing="10" style="-fx-padding: 20 0;">
                <Button text="Gérer Médecins"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER-LEFT;"/>
                <Button text="Gérer Patients"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER-LEFT;"/>
                <Button text="Rendez-vous"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER-LEFT;"/>
            </VBox>
        </VBox>

        <!-- Main Content -->
        <VBox style="-fx-padding: 30;" HBox.hgrow="ALWAYS">
            <Text text="Liste des Médecins"
                  style="-fx-font-size: 24px; -fx-fill: #05696B; -fx-font-weight: bold;"/>

            <!-- Search and Filter Section -->
            <HBox spacing="20" style="-fx-padding: 20 0;">
                <TextField fx:id="searchField" promptText="Rechercher..."
                           style="-fx-pref-width: 300;"/>
                <ComboBox fx:id="filterRegion" promptText="Filtrer par région"/>
                <Button text="Actualiser"
                        style="-fx-background-color: #05696B; -fx-text-fill: white;"
                        onAction="#refreshTable"/>
            </HBox>

            <!-- Table -->
            <TableView fx:id="medecinTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="idColumn" text="ID"/>
                    <TableColumn fx:id="nomColumn" text="Nom"/>
                    <TableColumn fx:id="prenomColumn" text="Prénom"/>
                    <TableColumn fx:id="ageColumn" text="Age"/>
                    <TableColumn fx:id="genreColumn" text="Genre"/>
                    <TableColumn fx:id="adresseColumn" text="Adresse"/>
                    <TableColumn fx:id="etatCivilColumn" text="État Civil"/>
                    <TableColumn fx:id="regionColumn" text="Région"/>
                    <TableColumn fx:id="emailColumn" text="Email"/>
                    <TableColumn fx:id="telephoneColumn" text="Téléphone"/>
                </columns>
            </TableView>
        </VBox>
    </HBox>
</AnchorPane>

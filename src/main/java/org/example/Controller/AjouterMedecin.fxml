<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.GUI.AjouterMedecinController"
            style="-fx-background-color: #FFFFFF;">

    <HBox AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0">
        <!-- Left Sidebar -->
        <VBox style="-fx-background-color: #05696B; -fx-padding: 20;" prefWidth="180">
            <Label text="Gestion Clinique" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>

            <!-- Menu Items -->
            <VBox spacing="10" style="-fx-padding: 20 0;">
                <Button text="Gérer Médecins"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER-LEFT;"/>
                <Button text="Gérer Patients"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER-LEFT;"/>
                <Button text="Rendez-vous"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER-LEFT;"/>
            </VBox>
        </VBox>

        <!-- Main Content -->
        <VBox style="-fx-padding: 40;" HBox.hgrow="ALWAYS">
            <GridPane hgap="20" vgap="20">
                <!-- Nom et Prénom -->
                <VBox GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Nom" style="-fx-text-fill: #05696B;"/>
                    <TextField fx:id="nomMedecinTf" promptText="Type here"
                               style="-fx-pref-width: 250;"/>
                </VBox>

                <VBox GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="Prénom" style="-fx-text-fill: #05696B;"/>
                    <TextField fx:id="prenomMedecinTf" promptText="Type here"
                               style="-fx-pref-width: 250;"/>
                </VBox>

                <!-- Age et Genre -->
                <VBox GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <Label text="Age" style="-fx-text-fill: #05696B;"/>
                    <TextField fx:id="ageTf" promptText="Type here"/>
                </VBox>

                <VBox GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <Label text="Genre" style="-fx-text-fill: #05696B;"/>
                    <HBox spacing="20">
                        <RadioButton text="Masculine" selected="true"/>
                        <RadioButton text="Feminine"/>
                    </HBox>
                </VBox>

                <!-- Adresse et État Civil -->
                <VBox GridPane.columnIndex="0" GridPane.rowIndex="2">
                    <Label text="Adresse" style="-fx-text-fill: #05696B;"/>
                    <TextField fx:id="adresseTf" promptText="Type here"/>
                </VBox>

                <VBox GridPane.columnIndex="1" GridPane.rowIndex="2">
                    <Label text="État civil" style="-fx-text-fill: #05696B;"/>
                    <HBox spacing="20">
                        <RadioButton text="Marié(e)"/>
                        <RadioButton text="Célibataire"/>
                    </HBox>
                </VBox>

                <!-- Région -->
                <VBox GridPane.columnIndex="0" GridPane.rowIndex="3">
                    <Label text="Région" style="-fx-text-fill: #05696B;"/>
                    <ComboBox fx:id="regionComboBox" prefWidth="250" promptText="Sélectionner région">
                    </ComboBox>
                </VBox>

                <!-- Email et Téléphone -->
                <VBox GridPane.columnIndex="1" GridPane.rowIndex="3">
                    <Label text="Adresse e-mail" style="-fx-text-fill: #05696B;"/>
                    <TextField fx:id="emailTf" promptText="Type here"/>
                </VBox>

                <VBox GridPane.columnIndex="0" GridPane.rowIndex="4">
                    <Label text="Numéro de téléphone" style="-fx-text-fill: #05696B;"/>
                    <TextField fx:id="telephoneTf" promptText="Type here"/>
                </VBox>
            </GridPane>

            <!-- Button -->
            <Button text="Suivant"
                    style="-fx-background-color: #05696B; -fx-text-fill: white; -fx-pref-width: 150;"
                    onAction="#enregistrer"
                    translateY="30"/>
        </VBox>
    </HBox>
</AnchorPane>
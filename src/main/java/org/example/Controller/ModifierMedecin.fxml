<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.GUI.ModifierMedecinController"
            style="-fx-background-color: #FFFFFF;">

    <HBox AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0">
        <!-- Left Sidebar -->
        <VBox style="-fx-background-color: #05696B; -fx-padding: 20;" prefWidth="200">
            <Label text="Gestion Clinique"
                   style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>

            <!-- Menu Items -->
            <VBox spacing="10" style="-fx-padding: 20 0;">
                <Button text="Gérer Médecins"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER-LEFT;"/>
                <Button text="Gérer Patients"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER-LEFT;"/>
                <Button text="Rendez-vous"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER-LEFT;"/>
            </VBox>
        </VBox>

        <!-- Main Content -->
        <VBox style="-fx-padding: 30;" HBox.hgrow="ALWAYS">
            <Text text="Modifier un Médecin"
                  style="-fx-font-size: 24px; -fx-fill: #05696B; -fx-font-weight: bold;"/>

            <GridPane hgap="20" vgap="20" style="-fx-padding: 30 0;">
                <!-- Nom et Prénom -->
                <VBox GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Nom" style="-fx-text-fill: #05696B;"/>
                    <TextField fx:id="nomField" promptText="Nom" style="-fx-pref-width: 250;"/>
                </VBox>

                <VBox GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="Prénom" style="-fx-text-fill: #05696B;"/>
                    <TextField fx:id="prenomField" promptText="Prénom" style="-fx-pref-width: 250;"/>
                </VBox>

                <!-- Age et Genre -->
                <VBox GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <Label text="Age" style="-fx-text-fill: #05696B;"/>
                    <TextField fx:id="ageField" promptText="Age"/>
                </VBox>

                <VBox GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <Label text="Genre" style="-fx-text-fill: #05696B;"/>
                    <HBox spacing="20">
                        <RadioButton fx:id="masculinRadio" text="Masculine" toggleGroup="$genreGroup"/>
                        <RadioButton fx:id="femininRadio" text="Feminine" toggleGroup="$genreGroup"/>
                    </HBox>
                </VBox>

                <!-- Adresse et État Civil -->
                <VBox GridPane.columnIndex="0" GridPane.rowIndex="2">
                    <Label text="Adresse" style="-fx-text-fill: #05696B;"/>
                    <TextField fx:id="adresseField" promptText="Adresse"/>
                </VBox>

                <VBox GridPane.columnIndex="1" GridPane.rowIndex="2">
                    <Label text="État civil" style="-fx-text-fill: #05696B;"/>
                    <HBox spacing="20">
                        <RadioButton fx:id="marieRadio" text="Marié(e)" toggleGroup="$etatCivilGroup"/>
                        <RadioButton fx:id="celibataireRadio" text="Célibataire" toggleGroup="$etatCivilGroup"/>
                    </HBox>
                </VBox>

                <!-- Région et Email -->
                <VBox GridPane.columnIndex="0" GridPane.rowIndex="3">
                    <Label text="Région" style="-fx-text-fill: #05696B;"/>
                    <ComboBox fx:id="regionComboBox" prefWidth="250"/>
                </VBox>

                <VBox GridPane.columnIndex="1" GridPane.rowIndex="3">
                    <Label text="Email" style="-fx-text-fill: #05696B;"/>
                    <TextField fx:id="emailField" promptText="Email"/>
                </VBox>

                <!-- Téléphone -->
                <VBox GridPane.columnIndex="0" GridPane.rowIndex="4">
                    <Label text="Téléphone" style="-fx-text-fill: #05696B;"/>
                    <TextField fx:id="telephoneField" promptText="Téléphone"/>
                </VBox>
            </GridPane>

            <!-- Buttons -->
            <HBox spacing="20" alignment="CENTER" style="-fx-padding: 20 0;">
                <Button text="Enregistrer"
                        style="-fx-background-color: #05696B; -fx-text-fill: white; -fx-pref-width: 150;"
                        onAction="#enregistrerModifications"/>
                <Button text="Annuler"
                        style="-fx-background-color: #95A5A6; -fx-text-fill: white; -fx-pref-width: 150;"
                        onAction="#annuler"/>
            </HBox>
        </VBox>
    </HBox>
</AnchorPane>